# Copy this file to `.env` and fill in the values.

# Database connection. Default is a local SQLite file.
DATABASE_URL="file:./dev.db"

# REQUIRED in production: a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_PASSWORD=""

# Anthropic API key for AI receipt extraction (https://console.anthropic.com).
# If left blank, receipts are still uploaded but fields must be entered manually.
ANTHROPIC_API_KEY=""

# Optional: model used for receipt extraction.
CLAUDE_MODEL="claude-sonnet-4-6"

# The first user who registers with this email becomes an admin automatically.
ADMIN_EMAIL=""

# Where uploaded receipts are stored on disk.
# Local: leave blank (defaults to ./uploads).
# Railway: set to a path on your mounted Volume, e.g. /app/data/uploads
UPLOAD_DIR=""
