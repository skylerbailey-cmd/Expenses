# Copy this file to `.env` and fill in the values.

# Database connection. Default is a local SQLite file.
DATABASE_URL="file:./dev.db"

# REQUIRED in production: a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_PASSWORD=""

# Anthropic API key for AI receipt extraction (https://console.anthropic.com).
# If left blank, receipts are still uploaded but fields must be entered manually.
ANTHROPIC_API_KEY=""

# Optional: model used for receipt extraction.
CLAUDE_MODEL="claude-sonnet-4-6"

# The first user who registers with this email becomes an admin automatically.
ADMIN_EMAIL=""

# Where uploaded receipts are stored on disk.
# Local: leave blank (defaults to ./uploads).
# Railway: set to a path on your mounted Volume, e.g. /app/data/uploads
UPLOAD_DIR=""

# --- QuickBooks Online integration (optional) ---
# Create an app at https://developer.intuit.com to get these keys, and register
# the redirect URI shown on the in-app Settings page (APP_URL + /api/quickbooks/callback).
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="production"   # "sandbox" while testing, "production" when live
# Public base URL of this app (used to build the OAuth redirect URI).
APP_URL="http://localhost:3000"
