// Prisma schema for the Expenses app.
// SQLite keeps the app self-contained and easy to run for a small business.
// Switch `provider` to "postgresql" and update DATABASE_URL to scale later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String          @default("EMPLOYEE") // EMPLOYEE | ADMIN
  createdAt    DateTime        @default(now())
  reports      ExpenseReport[]
}

model ExpenseReport {
  id                 String    @id @default(cuid())
  title              String
  submitterFirstName String
  submitterLastName  String
  // Workflow: DRAFT -> SUBMITTED -> (RETURNED -> SUBMITTED)* -> APPROVED -> PAID
  status             String    @default("DRAFT")
  adminNote          String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  expenses           Expense[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  submittedAt        DateTime?

  // QuickBooks sync tracking
  qboSyncedAt        DateTime?
  qboError           String?

  @@index([userId])
  @@index([status])
}

model Expense {
  id              String         @id @default(cuid())
  report          ExpenseReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId        String
  company         String?
  merchant        String?
  amount          Float?
  currency        String         @default("USD")
  category        String?
  description     String?
  transactionDate DateTime?
  images          ExpenseImage[]
  aiRaw           String? // JSON snapshot of what the AI returned
  aiConfidence    String? // low | medium | high
  needsReview     Boolean        @default(false)
  qboPurchaseId   String? // QuickBooks Purchase id once synced (prevents duplicates)
  createdAt       DateTime       @default(now())

  @@index([reportId])
}

model ExpenseImage {
  id        String   @id @default(cuid())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String
  path      String // served URL, e.g. /api/files/abc.jpg
  createdAt DateTime @default(now())

  @@index([expenseId])
}

// Single-row table holding the QuickBooks Online OAuth connection + settings.
// There is one company connection for the whole app (id is always "default").
model QuickBooksConnection {
  id                    String   @id @default("default")
  realmId               String // QuickBooks company id
  environment           String   @default("production") // sandbox | production
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  // The account purchases are paid from (bank or credit card) + how.
  paymentAccountId      String?
  paymentAccountName    String?
  paymentType           String   @default("CreditCard") // Cash | Check | CreditCard
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Maps an app expense category (e.g. "Rideshare") to a QuickBooks expense account.
model QboAccountMap {
  category    String @id // matches CATEGORIES values
  accountId   String
  accountName String
}
